{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/uploads/(.*)", "dest": "/api/index.js" },
    { "src": "/health", "dest": "/api/index.js" },
    {
      "src": "/(css|js)/(.*)",
      "dest": "/frontend/$1/$2"
    },
    {
      "src": "/(.+\\.(?:html|css|js|ico|png|jpg|jpeg|gif|svg|webp|woff2?))",
      "dest": "/frontend/$1"
    },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
